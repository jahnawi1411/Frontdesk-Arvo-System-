# Frontdesk Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection:
# For local SQLite zero-dependency mode:
DATABASE_URL="file:./dev.db"

# For PostgreSQL production / Docker mode:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/frontdesk?schema=public"

# Authentication
JWT_SECRET="super-secret-frontdesk-jwt-token-key-arvo-systems-2026"
JWT_EXPIRES_IN="7d"

# SLA Configuration Defaults
SLA_WORK_START="09:30"
SLA_WORK_END="18:30"
SLA_WORK_DAYS="1,2,3,4,5" # Monday to Friday

# Durations in working hours
SLA_URGENT_FIRST_RESPONSE_HOURS=2
SLA_URGENT_RESOLUTION_HOURS=9 # Same working day (9 working hours)
SLA_MEDIUM_FIRST_RESPONSE_HOURS=4.5 # Half working day
SLA_MEDIUM_RESOLUTION_HOURS=27 # 3 working days (27 working hours)
SLA_SMALL_FIRST_RESPONSE_HOURS=9 # 1 working day
SLA_SMALL_RESOLUTION_HOURS=45 # ~1 working week (5 working days = 45 working hours)

# Auto-close & Reopen windows in working days
SLA_AUTO_CLOSE_WORKING_DAYS=5 # ~1 working week
SLA_REOPEN_WINDOW_WORKING_DAYS=5 # ~1 working week

# Priority Change Policy: "RECALCULATE_FROM_REMAINING_RATIO" | "RESET_FROM_CREATION" | "RECALCULATE_FROM_NOW"
SLA_PRIORITY_CHANGE_POLICY="RECALCULATE_FROM_REMAINING_RATIO"
